#!/bin/sh
# driver-lint managed pre-commit v1
# Existing hook runs first, so its staged formatting is inspected by the gate.
driver_lint_original="$(dirname "$0")/pre-commit.driver-lint-original"
if test -x "$driver_lint_original"; then
    "$driver_lint_original" "$@" || exit "$?"
fi
driver_lint_root="$(git rev-parse --show-toplevel)" || exit 2
exec python3 "$driver_lint_root/driver_lint/scripts/commit_gate.py" --root "$driver_lint_root"
