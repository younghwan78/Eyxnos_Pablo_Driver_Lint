  "snapshot": "driver_lint/pablo_is/.state/reference.json",
  "checkpatch": {
    "script": "kernel-6.12/scripts/checkpatch.pl",
    "timeout_seconds": 45,
    "ignore": [
      "FILE_PATH_CHANGES",
      "COMMIT_MESSAGE",
      "COMMIT_COMMENT_SYMBOL",
      "SPDX_LICENSE_TAG"
    ]
  },
  "layer_patterns": [
    {
      "name": "test",
      "patterns": [
        "testing/*"
      ]
    },
    {
