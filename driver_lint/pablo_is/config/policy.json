    },
    {
      "name": "ischain",
      "patterns": [
        "ischain/*"
      ]
    },
    {
      "name": "sensor",
      "patterns": [
        "sensor/*",
        "csi/*"
      ]
    },
    {
      "name": "library",
      "patterns": [
        "lib/*",
        "icpu/*"
      ]
    },
    {
      "name": "interface",
      "patterns": [
        "interface/*",
        "include/*"
      ]
    },
    {
      "name": "vendor",
      "patterns": [
        "vendor/*"
      ]
    },
    {
      "name": "core",
      "patterns": [
        "*"
      ]
    }
  ],
  "raw_register_layers": [],
  "forbid_register_include_layers": [
