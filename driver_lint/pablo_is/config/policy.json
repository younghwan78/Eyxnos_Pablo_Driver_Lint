{
  "schema_version": 2,
  "profile": "profiles/s947b.json",
  "extensions": [
    ".c",
    ".h",
    ".bzl",
    ".bazel",
    ".fragment"
  ],
  "filenames": [
    "Makefile",
    "Kconfig"
  ],
  "exclude": [
    "*/.git/*",
    "*/__pycache__/*"
  ],
  "max_line_length": 100,
  "max_function_lines": 120,
  "max_patch_lines": 400,
  "long_line_exempt_paths": [
